import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, DecisionTreeRegressor
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
from sklearn.metrics import mean_squared_error, r2_score

# ===============================
# DATASET 1 : Diabetes
# ===============================

print("------ Diabetes Dataset ------")

df = pd.read_csv("diabetes.csv")

X = df.drop("Outcome", axis=1)
y = df["Outcome"]

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.25, random_state=42
)

# ----- ID3 Classification -----
clf = DecisionTreeClassifier(criterion="entropy")
clf.fit(X_train, y_train)

pred_clf = clf.predict(X_test)

print("\nID3 Classification Metrics:")
print("Accuracy :", accuracy_score(y_test, pred_clf))
print("Precision:", precision_score(y_test, pred_clf))
print("Recall   :", recall_score(y_test, pred_clf))
print("F1 Score :", f1_score(y_test, pred_clf))

# ----- CART Regression -----
reg = DecisionTreeRegressor()
reg.fit(X_train, y_train)

pred_reg = reg.predict(X_test)

print("\nCART Regression Metrics:")
print("MSE :", mean_squared_error(y_test, pred_reg))
print("R2  :", r2_score(y_test, pred_reg))


